# Keeps Alcove running in the background and starts it with the computer (systemd, per user).
# For a copy of Alcove in ~/alcove (edit the paths if yours is elsewhere):
#   cp deploy/alcove.service ~/.config/systemd/user/ && systemctl --user enable --now alcove
#   loginctl enable-linger $USER      # keep running when you're logged out
# Its settings come from ~/alcove/config.toml (copy config.example.toml to start).
[Unit]
Description=Alcove ebook library
After=network-online.target

[Service]
ExecStart=/usr/bin/env bash %h/alcove/run.sh
WorkingDirectory=%h/alcove
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
